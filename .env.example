CLASSIFIER_HOST=127.0.0.1
CLASSIFIER_PORT=8790
# Relative paths resolve from the repository root.
CLASSIFIER_DATA_DIR=./data
# Full OpenAI-compatible Chat Completions endpoint. Keys stay on the server.
CLASSIFIER_MODEL_API_URL=
CLASSIFIER_MODEL_API_KEY=
CLASSIFIER_MODEL=deepseek-chat

# Local OCR. Install Tesseract and the language packs; no model key is needed.
CLASSIFIER_TESSERACT=tesseract
CLASSIFIER_OCR_LANGS=chi_sim+eng
# Optional visual parser. Used only when explicitly selecting visual enhancement.
# The selected PDF page images are sent to this endpoint.
CLASSIFIER_VISION_API_URL=
CLASSIFIER_VISION_API_KEY=
CLASSIFIER_VISION_MODEL=
